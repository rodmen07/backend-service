# Server configuration
HOST=0.0.0.0
PORT=3000
DATABASE_URL=sqlite://app.db

# JWT auth validation (must match auth-service values)
AUTH_ENFORCED=true
AUTH_JWT_SECRET=replace-with-strong-secret
AUTH_JWT_ALGORITHM=HS256
AUTH_ISSUER=auth-service

# Optional public lead-intake forwarding target
# When set, POST /api/v1/public/lead-intake forwards payloads to this URL.
LEAD_INTAKE_FORWARD_URL=
